# Copy to .env and fill in. scripts/setup.ps1 creates .env for you with a random
# Neo4j password.

# --- Neo4j (runs natively; see scripts/neo4j.ps1) ---
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Data paths (relative paths resolve from the repo root) ---
ESCO_DATA_DIR=./data/raw/esco
NAUKRI_DATA_DIR=./data/raw/naukri
EXTERNAL_DATA_DIR=./data/raw/external
PROCESSED_DATA_DIR=./data/processed
ARTIFACTS_DIR=./artifacts
REPORTS_DIR=./reports
REFERENCE_DATA_DIR=./data/reference
GOLD_DATA_DIR=./data/gold
FAISS_INDEX_PATH=./data/processed/occupation.index

# --- Embedding models ---
MODEL_NAME=sentence-transformers/all-mpnet-base-v2
MULTILINGUAL_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# --- API ---
ENVIRONMENT=development
UVICORN_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Sent by the admin UI as the X-Admin-Token header. Leave empty to disable the
# check in development only.
ADMIN_TOKEN=
WARM_UP_MODELS=true

# --- Frontend (app/frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
